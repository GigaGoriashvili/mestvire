# ==============================================================================
# Mestvire Scraper Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your values for local development.
# In AWS Lambda environments, these values can be stored in AWS SSM Parameter Store
# under the prefix defined by SSM_PREFIX (default: /jobs).

# Telegram Configuration (Required)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token-from-botfather"
TELEGRAM_CHAT_ID="your-telegram-chat-or-channel-id"

# Google Gemini API Key (Required)
GEMINI_API_KEY="your-google-gemini-api-key"

# AWS Configuration (Optional / Defaults)
AWS_REGION="eu-central-1"
# DynamoDB table name for seen jobs tracking.
# For local testing/runs, use a separate table (e.g. jobs_tracker_dev)
# so local tests do not overwrite production state. Production defaults to jobs_tracker.
DYNAMODB_TABLE_NAME="jobs_tracker_dev"
SSM_PREFIX="/jobs"

# Filter Configuration (Optional, default: true)
# When set to true, automatically skips and filters Senior, Lead, Principal, and 5+ years experience roles.
FILTER_SENIOR_ROLES="true"
